# Copie este arquivo para .env.local (que já está no .gitignore) e preencha com
# valores reais. Nunca commitar .env.local nem .env.

# Envio de e-mail (Resend). Sem esta chave, os formulários continuam funcionando,
# mas o envio de e-mail é simulado (emailSent: false).
RESEND_API_KEY=

# Banco de dados (Supabase Postgres). Sem estas variáveis, as solicitações
# continuam sendo enviadas por e-mail normalmente, mas não ficam persistidas
# no banco - ou seja, o painel "Minhas Solicitações" não terá dados para mostrar.
#
# Como obter no Supabase: Project Settings -> Database -> Connect.
# DATABASE_URL: use o "Transaction pooler" (porta 6543) - é a usada em runtime
#   pela aplicação (cada rota de API é uma função serverless).
# DIRECT_URL: use o "Session pooler" (porta 5432, mesmo host do pooler) - só o
#   Prisma usa, para rodar `prisma migrate`. NÃO use o host "db.xxx.supabase.co"
#   direto - ele só funciona em redes com IPv6, o que causa erro P1001 em boa
#   parte das redes domésticas/provedores no Brasil.
#
# Nota: se sua senha do banco tiver caracteres especiais (@ : / # % ?), eles
# precisam ser "escapados" na URL (ex.: @ -> %40) ou o Prisma dá erro P1013.
DATABASE_URL=
DIRECT_URL=

# Área administrativa (/admin) - conta única e fixa (usuário + senha), não é
# login de verdade com múltiplos usuários. É só para não deixar a área onde
# se altera status e se excluem solicitações completamente aberta. Defina os
# dois valores e informe-os na tela de acesso do /admin. Se qualquer um ficar
# em branco, a área fica SEM proteção nesta instância (aviso no console do
# servidor).
ADMIN_LOGIN=
ADMIN_SENHA=

# Autenticação (Supabase Auth) - login antes de "Minhas Solicitações".
# Pegue os dois valores abaixo no mesmo projeto Supabase usado no banco:
# Project Settings -> API -> Project URL / anon public key. A anon key é
# pública por natureza (segura para expor no navegador); o controle de acesso
# real fica nas rotas de API, não nela.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lista de domínios de e-mail que podem criar conta (separados por vírgula,
# sem "@"), ex.: ALLOWED_STUDENT_EMAIL_DOMAINS=exemplo.edu.br,outro.edu.br
# Se deixado em branco, o cadastro fica aberto a qualquer e-mail (útil para
# desenvolvimento local, mas não deve ficar assim em uso real).
ALLOWED_STUDENT_EMAIL_DOMAINS=
