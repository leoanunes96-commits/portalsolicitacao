# Copie este arquivo para .env.local (que já está no .gitignore) e preencha com
# valores reais. Nunca commitar .env.local nem .env.

# Envio de e-mail (Resend). Sem esta chave, os formulários continuam funcionando,
# mas o envio de e-mail é simulado (emailSent: false).
RESEND_API_KEY=

# Banco de dados (Supabase Postgres). Sem estas variáveis, as solicitações
# continuam sendo enviadas por e-mail normalmente, mas não ficam persistidas
# no banco - ou seja, o painel "Minhas Solicitações" não terá dados para mostrar.
#
# Como obter no Supabase: Project Settings -> Database -> Connect.
# DATABASE_URL: use o "Transaction pooler" (porta 6543) - é a usada em runtime
#   pela aplicação (cada rota de API é uma função serverless).
# DIRECT_URL: use o "Session pooler" (porta 5432, mesmo host do pooler) - só o
#   Prisma usa, para rodar `prisma migrate`. NÃO use o host "db.xxx.supabase.co"
#   direto - ele só funciona em redes com IPv6, o que causa erro P1001 em boa
#   parte das redes domésticas/provedores no Brasil.
#
# Nota: se sua senha do banco tiver caracteres especiais (@ : / # % ?), eles
# precisam ser "escapados" na URL (ex.: @ -> %40) ou o Prisma dá erro P1013.
DATABASE_URL=
DIRECT_URL=

# Área administrativa (/admin) - código de acesso compartilhado, temporário.
# Não é login de verdade: é só para não deixar a área onde se altera status e
# se excluem solicitações completamente aberta enquanto o login institucional
# (RNF1) não existe. Defina qualquer valor (ex.: uma senha forte) e informe-o
# na tela de acesso do /admin. Se deixado em branco, a área fica SEM proteção
# nesta instância (um aviso aparece no console do servidor).
ADMIN_ACCESS_CODE="admin"
